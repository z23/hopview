pkgname=hopview
pkgver=0.5.0
pkgrel=1
pkgdesc="Native IPv4 and IPv6 network path monitor with interactive history"
license=('MIT')
arch=('x86_64' 'aarch64')
depends=('openssl' 'curl' 'glibc' 'libgcc' 'libglvnd' 'libstdc++' 'qt6-base' 'qt6-declarative' 'sqlite')
makedepends=('pkgconf')
options=('!debug')
source=("hopview-${pkgver}.tar.gz")
# bin/package pins this digest when creating the distributable source package.
sha256sums=('SKIP')

build() {
    cd "$srcdir/hopview"
    bin/build
}
package() {
    cd "$srcdir/hopview"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/hopview/LICENSE"
    install -Dm755 build-node/hopview-node "$pkgdir/usr/bin/hopview-node"
    install -Dm644 deploy/hopview-sysusers.conf "$pkgdir/usr/lib/sysusers.d/hopview.conf"
    for mode in collector receiver; do
        install -Dm644 "deploy/hopview-$mode.service" "$pkgdir/usr/lib/systemd/system/hopview-$mode.service"
        install -Dm644 "deploy/$mode.example.json" "$pkgdir/usr/share/doc/hopview/$mode.example.json"
    done
    install -Dm644 docs/telemetry.md "$pkgdir/usr/share/doc/hopview/telemetry.md"
    install -Dm755 build/hopview "$pkgdir/usr/bin/hopview"
    install -Dm644 pkgbuild/hopview.desktop "$pkgdir/usr/share/applications/hopview.desktop"
    install -Dm644 pkgbuild/hopview.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/hopview.svg"
}
