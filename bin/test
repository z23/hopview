#!/usr/bin/env bash
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
for suite in history integration; do
    mkdir -p "$root/build-tests/$suite"
    cd "$root/build-tests/$suite"
    qmake6 "$root/tests/$suite.pro" CONFIG+=release
    make -j"${JOBS:-4}"
    if [[ "$suite" == history ]]; then
        ./history_test
    else
        QT_QPA_PLATFORMTHEME=generic QT_QPA_PLATFORM=offscreen QT_QUICK_BACKEND=software ./integration_test
    fi
done
